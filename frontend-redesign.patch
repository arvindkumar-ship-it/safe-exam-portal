+  --accent: #e8833a;
+  --accent-hover: #d9742b;
+  --accent-active: #c76a25;
+  --accent-soft: #fdf1e6;
+  --accent-ring: rgba(232, 131, 58, .28);
+  --accent-ink: #a8531a;
+  /* Status */
+  --ok: #3b7a56;       --ok-soft: #eaf4ee;
+  --bad: #b3402d;      --bad-soft: #fbece8;
+  --warn: #946312;     --warn-soft: #fbf3df;
+  --info: #4a5f7a;     --info-soft: #eef2f7;
+  /* Shape & depth */
+  --r-sm: 6px; --r-md: 8px; --r-lg: 12px; --r-xl: 16px;
+  --shadow-sm: 0 1px 2px rgba(35, 32, 28, .04);
+  --shadow-md: 0 1px 2px rgba(35, 32, 28, .04), 0 8px 24px rgba(35, 32, 28, .06);
+  --shadow-lg: 0 2px 4px rgba(35, 32, 28, .05), 0 20px 48px rgba(35, 32, 28, .12);
+  /* Spacing (4px grid) */
+  --s-1: 4px; --s-2: 8px; --s-3: 12px; --s-4: 16px; --s-5: 20px; --s-6: 24px; --s-8: 32px; --s-10: 40px; --s-12: 48px;
+  /* Type */
+  --font: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --mono: ui-monospace, "SF Mono", "Cascadia Mono", Consolas, Menlo, monospace;
+  /* Motion */
+  --ease: cubic-bezier(.2, .7, .2, 1);
+  --t-fast: 140ms; --t-med: 200ms;
+  --control-h: 38px;
+  --topbar-h: 60px;
+
+  font-family: var(--font);
+  color: var(--text);
+  background: var(--bg);
+  font-size: 14px;
+  line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
