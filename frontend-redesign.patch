+/* ==========================================================================
+   SafeExam design system — light, warm-neutral, restrained accent.
+   Tokens → base → primitives → shell → pages. No logic lives here.
+   ========================================================================== */
+:root {
+  /* Surfaces */
+  --bg: #fbfaf8;
+  --surface: #ffffff;
+  --surface-2: #f7f5f1;
+  --surface-3: #f1eee8;
+  /* Lines */
+  --line: #ece9e3;
+  --line-strong: #ddd9d0;
+  /* Text */
+  --text: #23201c;
+  --text-2: #4a463f;
+  --muted: #6f6a62;
+  --faint: #9a958b;
