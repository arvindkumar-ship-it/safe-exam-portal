+
+/* ---------- Base ---------- */
+*, *::before, *::after { box-sizing: border-box; }
+html { background: var(--bg); }
+body { margin: 0; min-height: 100vh; background: var(--bg); }
+h1, h2, h3, h4 { margin: 0; color: var(--text); letter-spacing: -.012em; font-weight: 600; }
+h1 { font-size: 24px; line-height: 1.25; letter-spacing: -.02em; }
+h2 { font-size: 18px; line-height: 1.3; }
+h3 { font-size: 15px; line-height: 1.35; }
+h4 { font-size: 14px; }
+p { margin: 0; }
+a { color: var(--accent-ink); text-underline-offset: 3px; text-decoration-color: rgba(168, 83, 26, .35); transition: color var(--t-fast) var(--ease); }
+a:hover { color: var(--accent-active); }
+small { font-size: 12.5px; color: var(--muted); }
+code, pre { font-family: var(--mono); font-size: 12.5px; }
+pre { margin: var(--s-2) 0 0; padding: var(--s-3); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--r-md); overflow: auto; white-space: pre-wrap; }
+code { background: var(--surface-2); padding: 1px 6px; border-radius: var(--r-sm); }
+ul, ol { margin: 0; padding-left: 1.2em; }
+hr { border: 0; border-top: 1px solid var(--line); margin: var(--s-6) 0; }
+details > summary { cursor: pointer; color: var(--text-2); font-weight: 500; border-radius: var(--r-sm); padding: 2px 0; }
+details > summary:hover { color: var(--text); }
+::selection { background: var(--accent-soft); }
+
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm); }
 .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
