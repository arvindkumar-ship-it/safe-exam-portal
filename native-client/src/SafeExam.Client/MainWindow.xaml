<Window x:Class="SafeExam.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SafeExam" Width="1280" Height="800" Background="White">
    <Grid>
        <!-- Address bar nahi: sirf exam page -->
        <wv2:WebView2 x:Name="Browser" />
        <!-- WebView2 HWND-hosted hai (airspace) => status dikhate waqt Browser collapse hota hai -->
        <StackPanel x:Name="StatusPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720" Margin="32">
            <TextBlock x:Name="StatusText" FontSize="18" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="SystemCheckButton" Content="Run system check" Margin="0,24,0,0" Padding="16,6" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnSystemCheck" />
        </StackPanel>
    </Grid>
</Window>
